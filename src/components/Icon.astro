    ],
  },
  linkedin: {
    viewBox: '0 0 24 24',
    filled: true,
    paths: [
      'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
    ],
  },
  instagram: {
    viewBox: '0 0 24 24',
    paths: ['M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5Z', 'M16 11.37a4 4 0 1 1-7.914 1.174A4 4 0 0 1 16 11.37Z', 'M17.5 6.5h.01'],
  },
  mail: {
    viewBox: '0 0 24 24',
    paths: ['M3 6a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z', 'm3 7 9 6 9-6'],
  },
  'arrow-up-right': {
    viewBox: '0 0 24 24',
    paths: ['M7 17 17 7', 'M8 7h9v9'],
  },
  'arrow-right': {
    viewBox: '0 0 24 24',
    paths: ['M5 12h14', 'm13 6 6 6-6 6'],
  },
  'arrow-up': {
    viewBox: '0 0 24 24',
    paths: ['M12 19V5', 'm6 11 6-6 6 6'],
  },
  download: {
    viewBox: '0 0 24 24',
    paths: ['M12 3v12', 'm7 10 5 5 5-5', 'M5 21h14'],
  },
  check: {
    viewBox: '0 0 24 24',
    paths: ['m20 6-11 11-5-5'],
  },
  'chevron-down': {
    viewBox: '0 0 24 24',
    paths: ['m6 9 6 6 6-6'],
  },
};

const icon = icons[name];
const isFilled = Boolean(icon.filled);
---

<svg
  class={className}
  viewBox={icon.viewBox}
  fill={isFilled ? 'currentColor' : 'none'}
  stroke={isFilled ? 'none' : 'currentColor'}
  stroke-width={isFilled ? undefined : 1.6}
  stroke-linecap={isFilled ? undefined : 'round'}
  stroke-linejoin={isFilled ? undefined : 'round'}
  aria-hidden="true"
  focusable="false"
>
  {icon.paths.map((path) => <path d={path}></path>)}
  {icon.circles?.map((circle) => <circle {...circle}></circle>)}
</svg>
