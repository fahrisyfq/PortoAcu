---
type IconName =
  | 'github'
  | 'linkedin'
  | 'mail'
  | 'instagram'
  | 'arrow-up-right'
  | 'arrow-right'
  | 'arrow-up'
  | 'download'
  | 'check'
  | 'chevron-down';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = '' } = Astro.props;

const icons: Record<
  IconName,
  { viewBox: string; filled?: boolean; paths: string[]; circles?: Array<{ cx: number; cy: number; r: number }> }
> = {
  github: {
    viewBox: '0 0 24 24',
    filled: true,
