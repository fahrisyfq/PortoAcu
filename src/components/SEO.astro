---
import { site } from '../data/site';
import { asset } from '../utils/asset';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = `${site.name} — ${site.role} & ${site.secondaryRole}`,
  description = site.shortBio,
  image = '/images/og.png',
  noindex = false,
} = Astro.props;

const siteUrl = Astro.site ?? new URL(site.website);
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = new URL(asset(image), siteUrl).href;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: siteUrl.href,
  image: ogImage,
  jobTitle: `${site.role} & ${site.secondaryRole}`,
  description: site.shortBio,
  email: `mailto:${site.email}`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Semarang',
    addressCountry: 'ID',
  },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: site.campus,
  },
  sameAs: site.socials
    .filter((social) => social.href.startsWith('http'))
    .map((social) => social.href),
  knowsAbout: [
    'Web Development',
    'Frontend Engineering',
    'Astro',
    'React',
    'TypeScript',
    'CSS',
    'Accessibility',
  ],
};
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={site.name} />
<meta
  name="keywords"
  content="portofolio, mahasiswa teknik elektro, teknologi rekayasa komputer, web developer, front-end, Astro, React, TypeScript, Semarang"
/>
<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
<link rel="canonical" href={canonical} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content={`${site.name} — Portofolio`} />
<meta property="og:locale" content="id_ID" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`Kartu portofolio ${site.name}`} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={`Kartu portofolio ${site.name}`} />
<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
